vertex_program gridfWidthVertProgram hlsl
{
    source gridfWidthVert.hlsl
    entry_point mainVS
    target vs_4_0
    default_params {
		param_named_auto worldViewProj worldviewproj_matrix
    
	}
}

fragment_program gridfWidthFragProgram hlsl
{
    source gridfWidthFrag.hlsl
    entry_point mainPS
    target ps_4_0
    default_params{
        
        param_named_auto cameraPos camera_position

        param_named scale float 300.0

    }
}

material gridFwidth{
    receive_shadows off
    technique{
        pass{
            
            lighting off
		    depth_write off
            //lighting on
            
            scene_blend alpha_blend

            

            vertex_program_ref gridfWidthVertProgram{

            }
            fragment_program_ref gridfWidthFragProgram{

            }

        }
    }
}

