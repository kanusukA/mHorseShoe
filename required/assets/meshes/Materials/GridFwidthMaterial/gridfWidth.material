

vertex_program gridfWidthVertProgram glslang
{
    source gridfWidth.vert

    // entry_point main
    // target vs_5_0
    default_params {
		param_named_auto worldViewProj worldviewproj_matrix
        //param_named color float4 0 1 0 1
    
	}
}

fragment_program gridfWidthFragProgram glslang
{
    source gridfWidth.frag
    entry_point main
    //target ps_4_0
    default_params{
        
       // param_named_auto cameraPos camera_position

        //param_named scale float 300.0
        //param_named radius float 0.1
        param_named color float4 0.0 1.0 0.0 1.0

    }
}

material gridFFwidth{
    receive_shadows off
    technique{
        pass{
            
            lighting off
		    depth_write off
            //lighting on
            
            scene_blend alpha_blend

            

            vertex_program_ref gridfWidthVertProgram{

            }
            fragment_program_ref gridfWidthFragProgram{

            }

        }
    }
}

