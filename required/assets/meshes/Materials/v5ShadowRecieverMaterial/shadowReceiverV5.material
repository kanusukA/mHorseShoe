material ShadowReceiverV5
{
   // shadow_caster_material MyShadowCaster

    technique default
    {
        pass ambient
        {
            ambient 1 1 1
            diffuse 0.79 0.46 0.46 1.00
            specular 0 0 0 0 

           // depth_write off

           // scene_blend alpha_blend

            vertex_program_ref ShadowMapReceiverV5VPglsl
            {

            }
            fragment_program_ref ShadowMapReceiverV5FPglsl
            {

            }

           texture_unit 
           {
                content_type shadow
                tex_address_mode clamp
                filtering none
            }

            texture_unit Diffuse
            {
                
            }

            texture_unit NormalMap
            {

            }
            
            texture_unit DisplacementMap
            {

            }

            texture_unit Roughness
            {

            }


        }


    }
}