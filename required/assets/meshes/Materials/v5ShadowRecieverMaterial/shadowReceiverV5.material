fragment_program ShadowMapReceiverV5FP hlsl
{
    source shadowReceiverV5FP.hlsl
    entry_point mainFP
    profiles arbfp1
    target ps_4_0
    // Similar to standard lighting but using the shadow map in addition
    //compile_arguments -DSHADOW_MAP
    
