vertex_program gridVertProgram hlsl
{
    source gridVertProgram.hlsl
    entry_point mainVS
    target vs_4_0
    default_params {
		param_named_auto worldViewProj worldviewproj_matrix
    
	}
}

fragment_program gridFragProgram hlsl
{
    source gridFragProgram.hlsl
    entry_point mainPS
    target ps_4_0
    default_params{
        
        param_named_auto cameraPos camera_position

        param_named fade_radius float 0.4
        param_named fade_cutoff float 0.4

        param_named cell_size float 0.3,
        param_named sub_cell_size float 0.2,

        param_named cell_col float4 0.9 0.1 0.1 1.0
        param_named sub_cell_col float4 0.7 0.2 0.2 1.0

        param_named grid_line_width float 0.3
        param_named sub_grid_line_width float 0.2

    }
}

material myGrid{
    receive_shadows off
    technique{
        pass{
            
            lighting off
		    depth_write off
            //lighting on
            
            scene_blend alpha_blend

            

            vertex_program_ref gridVertProgram{

            }
            fragment_program_ref gridFragProgram{

            }

        }
    }
}

